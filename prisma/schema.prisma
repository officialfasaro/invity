datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  USER
  ADMIN
}

enum SubscriptionTier {
  FREE
  STARTER
  ELEGANT
  ULTIMATE
}

enum PaymentStatus {
  PENDING
  WAITING_VERIFICATION
  SETTLEMENT
  EXPIRED
  CANCELLED
}

enum PaymentType {
  GATEWAY
  MANUAL_QRIS
  MANUAL_BANK
}

model User {
  id                   String               @id @default(cuid())
  email                String               @unique
  passwordHash         String
  name                 String
  role                 UserRole             @default(USER)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  invitations          Invitation[]
  paymentTransactions  PaymentTransaction[]

  @@map("users")
}

model Invitation {
  id                   String               @id @default(cuid())
  slug                 String               @unique
  userId               String
  title                String
  themeId              String
  activeUntil          DateTime?
  isActive             Boolean              @default(true)
  coupleInfo           Json
  createdAt            DateTime             @default(now())

  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventSchedules       EventSchedule[]
  galleries            Gallery[]
  bankAccounts         BankAccount[]
  guests               Guest[]
  rsvps                Rsvp[]
  wishes               Wish[]
  paymentTransactions  PaymentTransaction[]

  @@map("invitations")
}

model EventSchedule {
  id           String     @id @default(cuid())
  invitationId String
  eventName    String
  date         DateTime
  startTime    String
  endTime      String?
  venueName    String
  address      String
  mapsUrl      String?
  latitude     Float?
  longitude    Float?

  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@map("event_schedules")
}

model Gallery {
  id           String     @id @default(cuid())
  invitationId String
  imageUrl     String
  caption      String?
  sortOrder    Int        @default(0)

  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@map("galleries")
}

model BankAccount {
  id            String     @id @default(cuid())
  invitationId  String
  bankName      String
  accountNumber String
  accountHolder String
  qrisImageUrl  String?

  invitation    Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@map("bank_accounts")
}

model Guest {
  id           String     @id @default(cuid())
  invitationId String
  name         String
  slugCode     String
  quota        Int        @default(1)
  phoneNumber  String?
  checkedInAt  DateTime?

  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@unique([invitationId, slugCode])
  @@map("guests")
}

model Rsvp {
  id            String     @id @default(cuid())
  invitationId  String
  guestName     String
  status        String
  attendeeCount Int        @default(1)
  sessionChosen String?
  createdAt     DateTime   @default(now())

  invitation    Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@map("rsvps")
}

model Wish {
  id           String     @id @default(cuid())
  invitationId String
  senderName   String
  message      String
  reaction     String?
  isHidden     Boolean    @default(false)
  createdAt    DateTime   @default(now())

  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@map("wishes")
}

model PaymentTransaction {
  id            String           @id @default(cuid())
  orderId       String           @unique
  userId        String
  invitationId  String?
  tier          SubscriptionTier
  amount        Decimal          @db.Decimal(12, 2)
  paymentType   PaymentType
  paymentStatus PaymentStatus    @default(PENDING)
  proofImageUrl String?
  verifiedBy    String?
  verifiedAt    DateTime?
  createdAt     DateTime         @default(now())

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitation    Invitation?      @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  @@map("payment_transactions")
}

model ThemeCatalog {
  id          String   @id @default(cuid())
  themeKey    String   @unique
  name        String
  category    String   @default("Minimalist")
  thumbnail   String
  previewUrl  String?
  isActive    Boolean  @default(true)
  isPremium   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("theme_catalogs")
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

