{
  "name": "fasaro-invity",
  "version": "1.0.0",
  "private": true,
  "description": "Fasaro Wedding Platform — Unified Monolithic Project (Vite + Express Serverless)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/dev.ts",
    "build": "prisma generate && vite build",
    "build:client": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@sanity/client": "^8.9.0",
    "@supabase/supabase-js": "^2.49.1",
    "@tailwindcss/vite": "^4.3.3",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.42.0",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "^7.18.4",
    "sanitize-html": "^2.17.7",
    "three": "^0.186.1",
    "vite": "^8.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@types/three": "^0.186.0",
    "@vercel/node": "^5.1.16",
    "concurrently": "^9.1.2",
    "eslint": "^9",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "esbuild": true,
    "prisma": true,
    "unrs-resolver": true,
    "@prisma/client": true,
    "@prisma/engines": true
  }
}
