# ==============================================================================
# FASARO INVITY - UNIFIED ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Gunakan file ini sebagai template untuk membuat file `.env` di root direktori.
# Untuk deployment Vercel, salin variabel-variabel ini ke Project Settings > Environment Variables.

# ------------------------------------------------------------------------------
# 1. DATABASE (Prisma ORM - PostgreSQL)
# ------------------------------------------------------------------------------
# Contoh koneksi local PostgreSQL:
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/wedding_db?schema=public"
# Contoh koneksi Vercel / Supabase / Neon (Production):
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# ------------------------------------------------------------------------------
# 2. SUPABASE (Storage Buckets & Media Assets)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="wedding-assets"

# ------------------------------------------------------------------------------
# 3. AUTENTIKASI & JWT
# ------------------------------------------------------------------------------
# Generate string acak minimal 32 karakter (misal: openssl rand -base64 32)
NEXTAUTH_SECRET="your-super-secret-jwt-key-min-32-chars"
# Base URL aplikasi (Dev: http://localhost:3001, Prod: https://your-domain.vercel.app)
NEXTAUTH_URL="http://localhost:3001"

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (Midtrans Snap)
# ------------------------------------------------------------------------------
# Sandbox (Development): Prefix 'SB-Mid-...'
# Production: Prefix 'Mid-...'
MIDTRANS_SERVER_KEY="SB-Mid-server-YOUR_SANDBOX_SERVER_KEY"
MIDTRANS_CLIENT_KEY="SB-Mid-client-YOUR_SANDBOX_CLIENT_KEY"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-YOUR_SANDBOX_CLIENT_KEY"
MIDTRANS_IS_PRODUCTION="false"
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION="false"

# ------------------------------------------------------------------------------
# 5. GOOGLE OAUTH 2.0 (Login Google)
# ------------------------------------------------------------------------------
# Buat di Google Cloud Console: Credentials > OAuth 2.0 Client IDs
# 1. Authorized JavaScript Origins:
#    - Development : http://localhost:3001
#    - Production  : https://your-domain.vercel.app
# 2. Authorized Redirect URIs:
#    - Development : http://localhost:3001/api/auth/google/callback
#    - Production  : https://your-domain.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"

# ------------------------------------------------------------------------------
# 6. SANITY CMS (Konten & Manajemen Aset)
# ------------------------------------------------------------------------------
SANITY_PROJECT_ID="your-sanity-project-id"
SANITY_DATASET="production"
SANITY_API_VERSION="2024-01-01"
SANITY_API_TOKEN="your-sanity-write-token"
VITE_SANITY_PROJECT_ID="your-sanity-project-id"
VITE_SANITY_DATASET="production"
VITE_SANITY_API_VERSION="2024-01-01"

# ------------------------------------------------------------------------------
# 7. DEVELOPMENT SERVER & PROXY (Hanya untuk lokal dev)
# ------------------------------------------------------------------------------
PORT=5001
BACKEND_URL="http://localhost:5001"
# Origins CORS yang diizinkan (pisahkan dengan koma jika lebih dari satu)
FRONTEND_URL="http://localhost:3001,http://127.0.0.1:3001"
